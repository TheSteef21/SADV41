.Likes, .Comments { margin-right: 12px; }

.Likes .LikeSpriteHover { display: none; }

.Likes:hover .LikeSpriteHover { display: inline-block; }

.Likes:hover .LikeSprite { display: none; }

.Comments:hover, .Save:hover { opacity: 0.5; }

