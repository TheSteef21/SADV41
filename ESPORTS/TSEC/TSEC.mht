._ad9v:last-child { margin-bottom: 0px; }

._ad9u:last-child { margin-right: 0px; }

._ad9u:hover { opacity: 0.5; }

.Embed { display: block; font-family: var(--font-family-system); font-size: var(--system-14-font-size); line-height: var(--system-14-line-height); -webkit-tap-highlight-color: transparent; text-align: left; user-select: none; }

.Embed:hover { cursor: pointer; }

.Embed a { color: rgb(var(--ig-primary-text)); }

.Embed a:hover { text-decoration: underline; }

.Content { padding-bottom: 100%; position: relative; }

.Content.EmbedFrameWithProfile { padding-bottom: 0px; }

.EmbeddedMedia { background-color: rgb(var(--ig-secondary-background)); inset: 0px; position: absolute; }

.EmbeddedMedia:active { opacity: 1; }

.EmbeddedMediaImage { height: 100%; pointer-events: none; width: 100%; }

.EmbeddedMediaImageOverlay { filter: blur(25px) brightness(0.7); height: 100%; object-fit: cover; pointer-events: none; width: 100%; }

.MediaOverlayInfo { height: 100%; overflow: hidden; position: relative; width: 100%; background-color: rgb(var(--web-always-white)); }

.MediaOverlayInfoTextContainer { flex-direction: row; left: 50%; position: absolute; text-align: center; top: 50%; transform: translate(-50%, -50%); z-index: 1; }

.MediaOverlayInfoTitle { color: rgb(var(--web-always-white)); font-size: large; font-weight: 600; }

.MediaOverlayInfoDescription { color: rgb(var(--web-always-white)); font-size: small; font-weight: 400; }

.MediaOverlayButton { background-color: rgb(var(--web-always-white)); border-radius: 50px; padding: 15px; }

.MediaOverlayButtonText { color: rgb(var(--web-always-black)); font-weight: 600; }

a.EmbedVisitInstagram { color: rgb(var(--ig-primary-button)); font-size: 14px; font-weight: 550; line-height: 18px; margin-top: 24px; }

a.EmbedVisitInstagram:hover { text-decoration: none; }

.embedLogoItem { transform: scale(0.71); }

.embedLogoItemEnlarge { margin-bottom: 12px; margin-top: 12px; transform: scale(1.42); }

.Header { align-items: center; box-sizing: border-box; display: flex; flex-direction: row; height: 54px; padding: 10px; }

.AvatarContainer { align-items: center; background-color: rgb(var(--web-always-white)); border-radius: 50%; display: flex; flex-direction: column; justify-content: center; padding: 2px; }

.Avatar { display: block; height: 30px; width: 30px; }

.CollabAvatarContainer { position: relative; height: 30px; width: 30px; margin-left: 4px; }

.CollabAvatar { display: block; height: 24px; width: 24px; background-color: rgb(var(--web-always-white)); border-radius: 50%; position: absolute; left: -5px; top: -5px; border-width: 1px; border-image: none; border-style: solid; border-color: rgb(var(--web-always-white)); }

.SecondCollabAvatar { position: absolute; left: 5px; top: 5px; }

.InsideRing { position: absolute; }

.Avatar img { border-radius: 50%; height: 30px; width: 30px; }

.Avatar:hover { opacity: 0.5; }

.CollabAvatar img { border-radius: 50%; height: 24px; width: 24px; }

a.CollabAvatar::after { border: 1px solid rgba(var(--web-always-black),.0975); border-radius: 50%; content: ""; inset: 0px; pointer-events: none; position: absolute; }

.StoryRing { display: block; }

.HeaderText { align-items: flex-start; flex-grow: 1; flex-shrink: 1; margin: 0px 10px; overflow: hidden; }

.HeaderSecondaryContent { color: rgb(var(--ig-secondary-text)); flex-direction: row; font-size: 12px; line-height: 14px; }

.HeaderSecondaryContent > ::before { content: " Â·"; display: inline-block; margin-left: 4px; margin-right: 4px; }

.HeaderSecondaryContent > :first-child::before { display: none; }

@media (max-width: 330px) {
  .FromIGTV { display: none; }
  .FollowerCountText::before { display: none; }
}

div.CollabUsernameRow { align-items: center; display: flex; flex-direction: row; white-space: nowrap; width: 100%; }

a.Username { align-items: center; display: flex; flex-direction: row; font-weight: var(--font-weight-system-semibold); text-overflow: ellipsis; white-space: nowrap; width: 100%; }

a.CollabUsername { font-weight: var(--font-weight-system-semibold); }

span.CollabUsernameText, span.CollabSeparator { margin-left: 4px; white-space: nowrap; }

a.Username .UsernameText { display: block; max-width: calc(100% - 21px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

a.CollabUsername .UsernameText { display: block; max-width: calc(200% - 21px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.LocationAndSponsor { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.VerifiedSprite { margin-left: 5px; width: 12px; }

.HeaderCta { display: flex; flex: 1 1 auto; flex-flow: row; justify-content: flex-end; margin-left: 15px; }

a.ViewProfileButton, a.FollowButton { background-color: rgb(var(--ig-primary-button)); border-radius: 3px; color: rgb(var(--web-always-white)); flex-shrink: 0; font-weight: var(--font-weight-system-semibold); margin-left: 10px; padding: 5px 12px; text-decoration: none; }

.NewEmbedUI a.ViewProfileButton, .NewEmbedUI a.FollowButton { background-color: rgb(74, 93, 249); border-radius: 8px; }

a.ViewProfileButton:hover, a.FollowButton:hover { background-color: rgb(var(--blue-6)); text-decoration: none; }

.NewEmbedUI a.ViewProfileButton:hover, .NewEmbedUI a.FollowButton:hover { background-color: rgb(65, 80, 247); }

.NewEmbedUI a.ViewProfileButton:active, .NewEmbedUI a.FollowButton:active { background-color: rgb(65, 80, 247); transform: scale(0.98); }

.NewEmbedUI a.FeedbackCount, .NewEmbedUI a.FeedbackCount:hover { text-decoration: none; }

