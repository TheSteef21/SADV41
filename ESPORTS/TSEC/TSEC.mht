.NewEmbedUI .FeedbackIcon { transition: transform 0.15s ease-in-out; }

.NewEmbedUI .Feedback .FeedbackCount { color: rgb(var(--ig-primary-text)); font-size: 14px; font-weight: var(--font-weight-system-semibold); margin-left: 6px; }

