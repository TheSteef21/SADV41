        /* GLITCH Y FONDOS DE CAOS */
        @keyframes pageGlitch {
            0% { transform: translate(0) skew(0deg); filter: hue-rotate(0deg); }
            20% { transform: translate(-10px, 6px) skew(-5deg); filter: hue-rotate(180deg) contrast(200%) invert(0.1); }
            40% { transform: translate(10px, -6px) skew(5deg); filter: hue-rotate(-90deg) invert(0.2); }
            60% { transform: translate(-4px, 4px) skew(-3deg); filter: hue-rotate(90deg) drop-shadow(0 0 20px var(--cyan)); }
