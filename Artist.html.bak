    <!-- ==========================================
         SISTEMA LÓGICO OMNIPRESENTE (JS)
         ========================================== -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            
            // 1. GLITCH DE FONDO
            const mainBody = document.getElementById('mainBody');
            
            function randomGlitch() {
                if (Math.random() > 0.85) {
                    mainBody.classList.add('glitch-active');
                    setTimeout(() => {
                        mainBody.classList.remove('glitch-active');
                    }, 700);
                }
                setTimeout(randomGlitch, Math.random() * 5000 + 4000);
            }
            setTimeout(randomGlitch, 3000);

            // 2. METATRON 3D HUB (Adaptado a tu ecosistema)
            const nodesData = [
                { id:"STEVEN DIOR", color:"#d4af37" }, { id:"MÚSICA 432HZ", color:"#1DB954" },
                { id:"SADV41", color:"#00f3ff" }, { id:"WEB3 TOKEN", color:"#F3BA2F" },
                { id:"BURUNGA", color:"#ffffff" }, { id:"GSADV41", color:"#10b981" },
                { id:"TABERNÁCULO", color:"#9d4edd" }, { id:"TIENDA", color:"#FB542B" }
            ];

            const scene = document.getElementById('flower-scene');
            let nodeEls = [];

            function createPlane(transformStyle){
                const NS="http://www.w3.org/2000/svg";
                const svg=document.createElementNS(NS,"svg");
                svg.setAttribute("viewBox","-220 -220 440 440");
                svg.setAttribute("class","flower-plane");
                svg.style.transform=transformStyle;
                const radius=62; const centers=[{x:0,y:0}];
                for(let i=0;i<6;i++){const a=Math.PI/3*i;centers.push({x:radius*Math.cos(a),y:radius*Math.sin(a)})}
                for(let i=0;i<12;i++){const a=Math.PI/6*i;const d=(i%2===0)?radius*2:radius*Math.sqrt(3);centers.push({x:d*Math.cos(a),y:d*Math.sin(a)})}
                centers.forEach(c=>{
                    const g=document.createElementNS(NS,"g");
                    const circle=document.createElementNS(NS,"circle");
                    circle.setAttribute("cx",c.x);circle.setAttribute("cy",c.y);circle.setAttribute("r",radius);
                    circle.setAttribute("fill","none");circle.setAttribute("stroke","rgba(0,243,255,.4)");circle.setAttribute("stroke-width","0.8");
                    g.appendChild(circle);svg.appendChild(g);
                });
                return svg;
            }
            
            if(scene) {
                scene.appendChild(createPlane("rotateY(0deg) translateZ(-18px)"));
                scene.appendChild(createPlane("rotateY(60deg) translateZ(-18px)"));
                scene.appendChild(createPlane("rotateY(120deg) translateZ(-18px)"));
                scene.appendChild(createPlane("rotateX(90deg) translateZ(-18px)"));
            }

            const sphereRadius = 130, goldenAngle = Math.PI*(3-Math.sqrt(5));
            nodesData.forEach((node,i)=>{
                const y=1-(i/(nodesData.length-1))*2; const r=Math.sqrt(1-y*y);
                const theta=goldenAngle*i; const x=Math.cos(theta)*r; const z=Math.sin(theta)*r;
                const el=document.createElement('div'); el.className='node-3d';
                el.innerHTML=`<div class="node-dot" style="background:${node.color};color:${node.color};box-shadow:0 0 10px ${node.color}"></div><div class="node-label" style="color:${node.color}">${node.id}</div>`;
                el._pos={x:x*sphereRadius,y:y*sphereRadius,z:z*sphereRadius};
                if(scene) scene.appendChild(el);
                nodeEls.push(el);
            });

            let metatronRot={x:-18,y:24,z:0}, autoRot=true;
            function updateTrans(){ 
                if(!scene) return; 
                scene.style.transform=`scale3d(1,1,1) rotateX(${metatronRot.x}deg) rotateY(${metatronRot.y}deg) rotateZ(${metatronRot.z}deg)`;
                nodeEls.forEach(el=>{
                    const p=el._pos;
                    const radY=metatronRot.y*Math.PI/180, radX=metatronRot.x*Math.PI/180;
                    let x=p.x,y=p.y,z=p.z;
                    let x1=x*Math.cos(radY)+z*Math.sin(radY); let z1=-x*Math.sin(radY)+z*Math.cos(radY); x=x1;z=z1;
                    let y1=y*Math.cos(radX)-z*Math.sin(radX); let z2=y*Math.sin(radX)+z*Math.cos(radX); y=y1;z=z2;
                    el.style.transform=`translate3d(${p.x}px,${p.y}px,${p.z}px) translate(-50%,-50%) rotateY(${-metatronRot.y}deg) rotateX(${-metatronRot.x}deg)`;
                    el.style.zIndex=Math.floor(z+500);
                });
            }
            updateTrans();
            
            function loop(){ if(autoRot) { metatronRot.y+=0.15; metatronRot.z+=0.02; updateTrans(); } requestAnimationFrame(loop); }
            loop();

            const btnAuto = document.getElementById('toggleAuto');
            if(btnAuto) btnAuto.addEventListener('click', () => {
                autoRot = !autoRot;
                btnAuto.innerText = autoRot ? "AUTO: ON" : "AUTO: OFF";
                btnAuto.style.borderColor = autoRot ? "rgba(0,243,255,.4)" : "rgba(255,255,255,.2)";
                btnAuto.style.color = autoRot ? "var(--cyan)" : "#fff";
            });
        });

        // Toggle Sidebar Lateral
        function toggleSidebar() { document.getElementById('main-sidebar').classList.toggle('right-aligned'); }

        // ----------------------------------------------------
        // MOTOR WEB3 & FOUR.MEME (ETHERS.JS)
        // ----------------------------------------------------
        let web3Signer = null;
        let tradeMode = 'buy';

        async function connectBinance() {
            if (typeof window.ethereum !== 'undefined') {
                try {
                    await window.ethereum.request({ method: 'eth_requestAccounts' });
                    const provider = new ethers.BrowserProvider(window.ethereum);
                    web3Signer = await provider.getSigner();
                    const address = await web3Signer.getAddress();
                    
                    const statusBadge = document.getElementById('sync-status');
                    if(statusBadge) {
                        statusBadge.innerHTML = `<span class="w-2 h-2 mr-1.5 bg-green-400 rounded-full animate-pulse shadow-[0_0_5px_#10b981]"></span> WALLET: ${address.substring(0,6)}...${address.substring(38)}`;
                        statusBadge.classList.remove('hidden');
                    }
                    alert(`⚡ Wallet Conectada Exitosamente: ${address}`);
                } catch (error) {
                    alert(`❌ Error de conexión: ${error.message}`);
                }
            } else {
                alert("Instala una billetera Web3 (MetaMask o Binance Wallet) para sincronizar.");
            }
        }

        // Lógica de interfaz (Pestañas Buy / Sell)
        function setTradeMode(mode) {
            tradeMode = mode;
            const btnBuy = document.getElementById('tabBuy');
            const btnSell = document.getElementById('tabSell');
            const btnExec = document.getElementById('btnExecuteTrade');
            const lblAmt = document.getElementById('lblAmount');

            if(mode === 'buy') {
                btnBuy.className = "text-[9px] px-3 py-1.5 rounded bg-green-900/50 text-green-400 border border-green-700 font-bold transition-all";
                btnSell.className = "text-[9px] px-3 py-1.5 rounded bg-black text-slate-500 border border-slate-700 font-bold transition-all";
                
                btnExec.className = "bg-green-600 hover:bg-green-500 text-white font-bold text-[11px] px-5 py-2 rounded-lg transition-all shadow-[0_0_15px_rgba(22,163,74,0.4)] font-mono uppercase whitespace-nowrap";
                btnExec.innerText = "Ejecutar Compra";
                lblAmt.innerText = "CANTIDAD A INVERTIR (BNB)";
            } else {
                btnBuy.className = "text-[9px] px-3 py-1.5 rounded bg-black text-slate-500 border border-slate-700 font-bold transition-all";
                btnSell.className = "text-[9px] px-3 py-1.5 rounded bg-red-900/50 text-red-400 border border-red-700 font-bold transition-all";
                
                btnExec.className = "bg-renderRed hover:bg-red-500 text-white font-bold text-[11px] px-5 py-2 rounded-lg transition-all shadow-[0_0_15px_rgba(218,54,55,0.4)] font-mono uppercase whitespace-nowrap";
                btnExec.innerText = "Ejecutar Venta";
                lblAmt.innerText = "CANTIDAD A VENDER (SADV41)";
            }
        }

        // Lógica Transaccional
        async function ejecutarTransaccionFourMeme() {
            if (!web3Signer) {
                alert("Debes sincronizar tu wallet usando el botón 'Sync BNB' en la parte superior primero.");
                return;
            }
            try {
                const targetAddress = document.getElementById('targetToken').innerText;
                const amount = document.getElementById('cryptoAmount').value;
                
                if(tradeMode === 'buy') {
                    const tx = await web3Signer.sendTransaction({
                        to: targetAddress,
                        value: ethers.parseEther(amount.toString())
                    });
                    alert(`🚀 Transacción de COMPRA enviada. Esperando confirmación...\nHash: ${tx.hash}`);
                    await tx.wait();
                    alert(`✅ COMPRA EXITOSA CONFIRMADA EN LA BLOCKCHAIN.`);
                } else {
                    alert(`⏳ Iniciando protocolo de VENTA de ${amount} Tokens...\nEn un entorno de producción, esto interactuaría con el Router Contract.`);
                }
            } catch (error) {
                alert(`❌ Transacción rechazada o fallida: ${error.shortMessage || error.message}`);
            }
        }
    </script>
</body>
</html>
