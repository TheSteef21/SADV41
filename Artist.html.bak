        .glitch-active { animation: pageGlitch 0.7s cubic-bezier(.25, .46, .45, .94) both; }
        .layer-glitch { mix-blend-mode: color-dodge !important; transform: scale(1.2) rotate(-2deg) !important; filter: contrast(250%) saturate(400%) hue-rotate(270deg) drop-shadow(0 0 30px var(--violet)) !important; opacity: 1 !important; }

