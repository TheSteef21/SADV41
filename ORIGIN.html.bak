<!-- TRIFUERZA + IPFS -->
<section class="grid grid-cols-1 lg:grid-cols-2 gap-8">

<div class="logia-card p-8 rounded-3xl border border-oroTemple/30 text-center relative overflow-hidden">
<h3 class="font-decor text-xl text-oroTemple">TRIFUERZA CRISTIANA</h3>
<p class="font-mono text-[9px] text-slate-400 mt-2">PADRE • HIJO • ESPÍRITU SANTO = SPACEWORLD GOLDEN TRIANGLE</p>
<div class="mt-8 flex justify-center"><div class="relative w-48 h-40"><div class="absolute top-0 left-1/2 -translate-x-1/2 w-0 h-0 border-l-[40px] border-r-[40px] border-b-[70px] border-l-transparent border-r-transparent border-b-oroTemple drop-shadow-[0_0_20px_rgba(255,215,0,0.8)]"></div><div class="absolute bottom-0 left-2 w-0 h-0 border-l-[40px] border-r-[40px] border-b-[70px] border-l-transparent border-r-transparent border-b-cyanNeon drop-shadow-[0_0_20px_rgba(0,243,255,0.6)]"></div><div class="absolute bottom-0 right-2 w-0 h-0 border-l-[40px] border-r-[40px] border-b-[70px] border-l-transparent border-r-transparent border-b-violetNeon drop-shadow-[0_0_20px_rgba(157,78,221,0.6)]"></div></div></div>
<div class="mt-6 space-y-2 font-mono text-[9px] text-left bg-black/40 p-4 rounded-xl">
<p class="text-oroTemple">▲ PADRE = ORIGEN 0 = Spaceworld cielo dorado</p>
<p class="text-cyanNeon">▲ HIJO = NODO GRACIA 1+1 = Temple of Time Link</p>
<p class="text-violetNeon">▲ ESPÍRITU = RUTA 42KM = Ocarina guía brisa suave</p>
</div>
</div>

<div class="logia-card p-8 rounded-3xl border border-cyanNeon/30">
<h3 class="font-mason text-xl text-cyanNeon">IPFS // SELLADO INMUTABLE</h3>
