<div class="grid grid-cols-2 gap-3">
<div class="bg-black/40 p-3 rounded-lg border border-white/5 text-center"><p class="text-lg">🛡️</p><p class="font-mono text-[8px] text-slate-400 mt-1">NORTE<br>Guardián 1</p></div>
<div class="bg-black/40 p-3 rounded-lg border border-white/5 text-center"><p class="text-lg">⚔️</p><p class="font-mono text-[8px] text-slate-400 mt-1">SUR<br>Guardián 2</p></div>
<div class="bg-black/40 p-3 rounded-lg border border-white/5 text-center"><p class="text-lg">🏹</p><p class="font-mono text-[8px] text-slate-400 mt-1">ESTE<br>Guardián 3</p></div>
<div class="bg-black/40 p-3 rounded-lg border border-white/5 text-center"><p class="text-lg">🗡️</p><p class="font-mono text-[8px] text-slate-400 mt-1">OESTE<br>Guardián 4</p></div>
</div>
