<style>
:root{--oro:#d4af37;--cyan:#00f3ff;--violet:#9d4edd;--red:#FB542B;--obs:#030305}
*{box-sizing:border-box;margin:0;padding:0}
body{background:#030305;color:#f8fafc;font-family:Inter,system-ui,sans-serif;overflow-x:hidden}
.mono{font-family:'JetBrains Mono',monospace}
.mason{font-family:'Cinzel',serif}
.pirate{font-family:'Pirata One',cursive}
.marquee{position:fixed;top:0;width:100%;background:#000;border-bottom:1px solid var(--oro);padding:6px 0;z-index:99;overflow:hidden;white-space:nowrap;color:var(--oro);font-family:'JetBrains Mono';font-size:10px;letter-spacing:.2em;text-transform:uppercase}
.marquee span{display:inline-block;padding-left:100%;animation:m 28s linear infinite}
@keyframes m{0%{transform:translateX(0)}100%{transform:translateX(-100%)}}
.glass{background:rgba(8,12,28,.88);backdrop-filter:blur(18px);border:1px solid rgba(212,175,55,.2);border-radius:16px}
.card{background:linear-gradient(145deg,rgba(10,10,10,.88),rgba(20,20,20,.88));border:1px solid rgba(212,175,55,.18);border-radius:24px;padding:28px}
table{width:100%;border-collapse:collapse;font-family:'JetBrains Mono';font-size:11px}
th{background:rgba(212,175,55,.15);color:var(--oro);text-transform:uppercase;letter-spacing:.12em;padding:12px 8px;text-align:left;border-bottom:1px solid rgba(212,175,55,.3)}
td{padding:10px 8px;border-bottom:1px solid rgba(255,255,255,.06);vertical-align:top;color:#cbd5e1}
tr:hover td{background:rgba(0,243,255,.05)}
.tag{font-size:8px;padding:3px 6px;border-radius:999px;border:1px solid currentColor;display:inline-block}
@keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
.needle{animation:spin 20s linear infinite;transform-origin:center}
a{color:var(--cyan);text-decoration:none} a:hover{color:var(--oro)}
</style>
</head>
