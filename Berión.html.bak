<style>
:root{--oro:#d4af37;--oro-dim:rgba(212,175,55,.18);--cyan:#00f3ff;--violet:#9d4edd;--red:#FB542B;--spotify:#1DB954;--bg:#030305;--card:linear-gradient(145deg,rgba(10,10,10,.94),rgba(18,18,22,.94));--glass:rgba(8,12,28,.88);--text:#f8fafc;--muted:#94a3b8}
*{box-sizing:border-box;margin:0;padding:0} html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:system-ui,sans-serif;overflow-x:hidden;line-height:1.5}
.mono{font-family:'JetBrains Mono',monospace} .mason{font-family:'Cinzel',serif} .pirate{font-family:'Pirata One',cursive}
.marquee{position:fixed;top:0;width:100%;background:#000;border-bottom:1px solid var(--oro);padding:7px 0;z-index:100;overflow:hidden;white-space:nowrap;color:var(--oro);font-size:10px;letter-spacing:.22em;text-transform:uppercase;font-family:'JetBrains Mono'} .marquee span{display:inline-block;padding-left:100%;animation:marquee 32s linear infinite} @keyframes marquee{0%{transform:translateX(0)}100%{transform:translateX(-100%)}}
header{position:fixed;top:30px;left:0;width:100%;z-index:50;display:flex;justify-content:space-between;align-items:center;padding:14px 22px;flex-wrap:wrap;gap:12px;background:var(--glass);backdrop-filter:blur(20px);border-bottom:1px solid var(--oro-dim)}
header h1{color:var(--oro);letter-spacing:.2em;font-size:clamp(1.1rem,3vw,1.5rem)} .nav-links{display:flex;gap:10px;flex-wrap:wrap} .nav-links a{border:1px solid;padding:7px 14px;border-radius:999px;font-size:10px;font-family:'JetBrains Mono';transition:.25s} .nav-links a:hover{transform:translateY(-1px);background:rgba(212,175,55,.12)} .nav-oro{border-color:var(--oro);color:var(--oro)} .nav-red{border-color:var(--red);color:var(--red)} .nav-spotify{border-color:var(--spotify);color:var(--spotify)}
main{max-width:1280px;margin:0 auto;padding:130px 16px 90px;display:flex;flex-direction:column;gap:72px}
.card{background:var(--card);border:1px solid var(--oro-dim);border-radius:24px;padding:28px} .card-oro{border:2px solid var(--oro)} .card-red{border-top:4px solid var(--red)} .card-spotify{border-top:4px solid var(--spotify)}
.brujula-wrap{display:flex;justify-content:center;margin:32px 0 28px} .brujula-wrap svg{filter:drop-shadow(0 0 18px rgba(212,175,55,.25));max-width:100%;height:auto}
.legend{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:8px;font-size:11px;line-height:1.7;color:#cbd5e1} .legend-item{padding:16px;border-radius:14px;border-left:3px solid} .legend-oro{background:rgba(212,175,55,.08);border-color:var(--oro)} .legend-cyan{background:rgba(0,243,255,.06);border-color:var(--cyan)}
table{width:100%;border-collapse:collapse;font-family:'JetBrains Mono';font-size:11px} th{background:rgba(212,175,55,.15);color:var(--oro);text-transform:uppercase;letter-spacing:.12em;padding:12px 8px;text-align:left;border-bottom:1px solid rgba(212,175,55,.3)} td{padding:10px 8px;border-bottom:1px solid rgba(255,255,255,.06);color:#cbd5e1;vertical-align:top} tr:hover td{background:rgba(0,243,255,.05)} .tag{font-size:8px;padding:3px 6px;border-radius:999px;border:1px solid currentColor;display:inline-block}
.grid-albums{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;margin-top:28px} .album-card{background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.06);border-radius:16px;padding:12px;transition:.25s} .album-card:hover{border-color:rgba(212,175,55,.35);transform:translateY(-3px);box-shadow:0 12px 28px rgba(0,0,0,.4)} .album-label{font-size:9px;margin-bottom:8px} .album-label.spotify{color:var(--spotify)} .album-label.oro{color:var(--oro)} .album-label.muted{color:var(--muted)} iframe{border-radius:12px;width:100%;height:352px;border:0}
#metatron{position:relative;width:100%;padding:48px 20px;background:rgba(0,0,0,.92);border:1px solid rgba(212,175,55,.4);border-radius:24px;display:flex;flex-direction:column;align-items:center;overflow:hidden;box-shadow:0 0 60px rgba(157,78,221,.22)} .metatron-stage{position:relative;width:min(340px,88vw);height:min(340px,88vw);display:flex;align-items:center;justify-content:center;perspective:1400px;margin:12px 0 20px} .metatron-inner{width:100%;height:100%;position:relative;transform-style:preserve-3d;animation:spin3D 28s linear infinite} @keyframes spin3D{0%{transform:rotateX(18deg) rotateY(0) rotateZ(0)}50%{transform:rotateX(-12deg) rotateY(180deg) rotateZ(8deg)}100%{transform:rotateX(18deg) rotateY(360deg) rotateZ(0)}}
footer{text-align:center;padding:36px 20px;border-top:1px solid rgba(255,255,255,.08);font-size:9px;color:#64748b;font-family:'JetBrains Mono'} footer .oro{color:var(--oro)} a{color:var(--cyan);text-decoration:none} h2{letter-spacing:.2em;font-size:clamp(1.1rem,2.8vw,1.45rem)} .sub{font-size:10px;color:var(--muted);margin-top:8px;line-height:1.6} .center{text-align:center} .btn-pill{display:inline-block;padding:10px 22px;border-radius:999px;font-size:11px;font-family:'JetBrains Mono';transition:.25s} .btn-spotify{border:1px solid var(--spotify);color:var(--spotify)} .btn-spotify:hover{background:rgba(29,185,84,.12)} .btn-oro{border:1px solid var(--oro);color:var(--oro);background:rgba(212,175,55,.08)}
@media(max-width:640px){.legend{grid-template-columns:1fr} header{padding:12px 14px} main{padding:120px 12px 70px;gap:56px} .card{padding:20px 16px}}
</style>
</head>
