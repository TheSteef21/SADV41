  <!-- Widget Arrastrable 3: Leyenda de Magnitud -->
  <div id="widget-legend" class="draggable-widget">
    <div class="draggable-header"><span>⠿ Escala Richter / Mw</span></div>
    <div class="legend-grid">
      <div class="leg-item"><span class="leg-dot" style="background:#a855f7"></span>&lt; 2.5</div>
      <div class="leg-item"><span class="leg-dot" style="background:#32d4ff"></span>2.5–3.9</div>
      <div class="leg-item"><span class="leg-dot" style="background:#eab308"></span>4.0–4.9</div>
      <div class="leg-item"><span class="leg-dot" style="background:#f97316"></span>5.0–5.9</div>
      <div class="leg-item"><span class="leg-dot" style="background:#ef4444"></span>6.0–6.9</div>
      <div class="leg-item"><span class="leg-dot" style="background:#dc2626;box-shadow:0 0 6px #dc2626"></span>7.0+</div>
    </div>
  </div>

  <!-- Acceso Directo Agente -->
  <a href="./Agent/" class="btn-agent">AGENTE 🤖</a>

  <!-- Mapa Vectorial MapLibre GL -->
  <div id="map"></div>

  <!-- Scripts de Ecosistema SADV41 -->
  <script src="/SADV41/BIBLIA/biblia.js" defer></script>
  <script src="https://thesteef21.github.io/SADV41/sadv41-drag.js" defer></script>

  <!-- Barra de Noticias SADV41 -->
  <div id="sadv41-news" style="position:fixed;left:0;right:0;bottom:0;z-index:2147483000;background:#0a0e1a;color:#f4f6ff;border-top:2px solid #f5c542;font:600 12px/1.35 system-ui,sans-serif;padding:7px 40px 7px 12px;text-align:center">
    <span style="color:#f5c542">ÚLTIMA NOTICIA</span> · 
    <a href="https://thesteef21.github.io/SADV41/NEWS/PANAMA/USA/#paraguay" target="_blank" rel="noopener" style="color:#3ee0e8;text-decoration:none">Paraguay interviene Ueno Bank y renuncia el presidente del Banco Central 🏦</a>
    <button onclick="this.parentNode.style.display='none'" aria-label="Cerrar" style="position:absolute;right:10px;top:3px;background:none;border:0;color:#9aa3c7;font-size:18px;cursor:pointer">×</button>
  </div>

  <!-- Botón Home Cruz Dorada -->
  <a id="sadv41-home" href="https://thesteef21.github.io/Lapizasuli/GSADV41.html" title="SADV41 · Página principal" aria-label="Ir a la página principal de SADV41" style="position:fixed;left:14px;bottom:48px;z-index:2147482999;width:44px;height:44px;border-radius:50%;background:#071642;border:2.5px solid #d9a93a;box-shadow:0 4px 14px rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;text-decoration:none">
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><g fill="#d9a93a"><rect x="10.8" y="2" width="2.4" height="20" rx=".6"/><rect x="8" y="4.6" width="8" height="1.8" rx=".5"/><rect x="6" y="9" width="12" height="2.4" rx=".6"/><rect x="8.6" y="16.6" width="6.8" height="1.8" rx=".5" transform="rotate(12 12 17.5)"/></g></svg>
  </a>

  <script>
    // Configuración de Regiones Geológicas de América
    const REGIONES = {
      AMERICA:       { center: [-82.0, 12.0], zoom: 2.3, bbox: { minlat: -58.0, maxlat: 72.0, minlon: -170.0, maxlon: -32.0 } },
      CENTROAMERICA: { center: [-85.5, 13.0], zoom: 5.0, bbox: { minlat: 5.0,   maxlat: 22.0, minlon: -96.0,  maxlon: -75.0 } },
      PANAMA:        { center: [-80.2, 8.3],  zoom: 6.8, bbox: { minlat: 5.0,   maxlat: 11.0, minlon: -84.5,  maxlon: -76.0 } },
      SURAMERICA:    { center: [-68.0, -18.0],zoom: 3.1, bbox: { minlat: -58.0, maxlat: 13.0, minlon: -85.0,  maxlon: -34.0 } },
      NORTEAMERICA:  { center: [-105.0, 38.0],zoom: 3.2, bbox: { minlat: 14.0,  maxlat: 72.0, minlon: -170.0, maxlon: -52.0 } }
    };

    // Inicializar MapLibre GL con estilo oscuro vector/raster híbrido de alta velocidad
          const CARTO_KEY = 'cb1_4ne6_1_3c19f375f3946685db2cfede';
      const map = new maplibregl.Map({
        container: 'map',
        style: `https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json?key=${CARTO_KEY}`,
        center: REGIONES.AMERICA.center,
        zoom: REGIONES.AMERICA.zoom
      });

    map.addControl(new maplibregl.NavigationControl(), 'top-left');
    map.addControl(new maplibregl.GlobeControl(), 'top-left');

    const getColor = m => m >= 7.0 ? '#dc2626' : m >= 6.0 ? '#ef4444' : m >= 5.0 ? '#f97316' : m >= 4.0 ? '#eab308' : m >= 2.5 ? '#32d4ff' : '#a855f7';
    const fmtFecha = t => new Date(t).toLocaleString('es-PA', { timeZone: 'America/Panama', dateStyle: 'short', timeStyle: 'medium' });

    map.on('load', () => {
      // Fuente GeoJSON para sismos
      map.addSource('sismos-src', {
        type: 'geojson',
        data: { type: 'FeatureCollection', features: [] }
      });

      // Halo exterior de energía sísmica
      map.addLayer({
        id: 'sismos-halo',
        type: 'circle',
        source: 'sismos-src',
        paint: {
          'circle-radius': ['interpolate', ['linear'], ['get', 'mag'], 1, 6, 4, 14, 7, 36],
          'circle-color': ['get', 'color'],
          'circle-opacity': 0.22
        }
      });

      // Núcleo del epicentro
      map.addLayer({
        id: 'sismos-core',
        type: 'circle',
        source: 'sismos-src',
        paint: {
          'circle-radius': ['interpolate', ['linear'], ['get', 'mag'], 1, 3, 4, 7, 7, 18],
          'circle-color': ['get', 'color'],
          'circle-stroke-width': 1.5,
          'circle-stroke-color': '#ffffff',
          'circle-opacity': 0.9
        }
      });

      // Interactividad Popup
      map.on('click', 'sismos-core', (e) => {
        const props = e.features[0].properties;
        const coords = e.features[0].geometry.coordinates.slice();
        new maplibregl.Popup()
          .setLngLat(coords)
          .setHTML(`
            <div style="font-size:12px; line-height:1.45;">
              <div style="display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:4px;">
                <b style="font-size:15px; color:${props.color};">M ${Number(props.mag).toFixed(1)}</b>
                <span style="font-size:10px; background:#1c2733; padding:2px 6px; border-radius:6px; color:#94a3b8;">Prof: ${Math.round(props.depth)} km</span>
              </div>
              <div style="font-weight:700; color:#fff; margin-bottom:4px;">${props.place}</div>
              <div style="font-size:11px; color:#94a3b8;">🕒 ${props.fechaLocal} (Hora PA)</div>
              <a href="${props.url}" target="_blank" rel="noopener" style="display:inline-block; margin-top:6px; color:#32d4ff; font-weight:700; text-decoration:none;">Ver ficha USGS ↗</a>
            </div>
          `)
          .addTo(map);
      });

      map.on('mouseenter', 'sismos-core', () => map.getCanvas().style.cursor = 'pointer');
      map.on('mouseleave', 'sismos-core', () => map.getCanvas().style.cursor = '');

      cargarDatos(true);
    });

    async function cargarDatos(volar = false) {
      const regionKey = document.getElementById('regionSelect').value;
      const minMag = parseFloat(document.getElementById('magSelect').value);
      const dias = parseInt(document.getElementById('periodSelect').value);
      const statusEl = document.getElementById('status');
      const reg = REGIONES[regionKey];

      if (volar) {
        map.flyTo({ center: reg.center, zoom: reg.zoom, essential: true, duration: 1200 });
      }

      statusEl.textContent = 'SINCRONIZANDO USGS...';

      const fechaInicio = new Date(Date.now() - dias * 86400000).toISOString();
      const urlUSGS = `https://earthquake.usgs.gov/fdsnws/event/1/query?format=geojson&starttime=${fechaInicio}&minmagnitude=${minMag}&minlatitude=${reg.bbox.minlat}&maxlatitude=${reg.bbox.maxlat}&minlongitude=${reg.bbox.minlon}&maxlongitude=${reg.bbox.maxlon}&orderby=time&limit=3500`;

      try {
        const res = await fetch(urlUSGS);
        const data = await res.json();
        const rawFeatures = data.features || [];

        const timestampM77 = new Date('2026-10-09T17:56:00Z').getTime();
        let countPostM77 = 0;
        let maxMag = 0;

        const processedFeatures = rawFeatures.map(f => {
          const [lon, lat, depth] = f.geometry.coordinates;
          const mag = f.properties.mag || 0;
          const time = f.properties.time;

          if (time >= timestampM77) countPostM77++;
          if (mag > maxMag) maxMag = mag;

          return {
            type: 'Feature',
            geometry: { type: 'Point', coordinates: [lon, lat] },
            properties: {
              mag: mag,
              depth: depth,
              place: f.properties.place || 'Región Americana',
              url: f.properties.url,
              color: getColor(mag),
              fechaLocal: fmtFecha(time)
            }
          };
        });

        map.getSource('sismos-src').setData({
          type: 'FeatureCollection',
          features: processedFeatures
        });

        document.getElementById('cnt-visibles').textContent = processedFeatures.length;
        document.getElementById('cnt-maxmag').textContent = `M${maxMag.toFixed(1)}`;
        document.getElementById('cnt-m77').textContent = countPostM77;
        statusEl.textContent = `● LIVE: ${processedFeatures.length} SISMOS`;

      } catch (err) {
        statusEl.textContent = '❌ ERROR TELEMETRÍA';
      }
    }

    document.getElementById('regionSelect').addEventListener('change', () => cargarDatos(true));
    document.getElementById('magSelect').addEventListener('change', () => cargarDatos(false));
    document.getElementById('periodSelect').addEventListener('change', () => cargarDatos(false));

    // Sistema de Arrastre Unificado (Mouse + Touch) para Widgets
    function habilitarArrastre(elem) {
      let posX = 0, posY = 0, initialX = 0, initialY = 0;
      const dragHeader = elem.querySelector('.draggable-header') || elem;

      dragHeader.addEventListener('mousedown', (e) => {
        e.preventDefault();
        initialX = e.clientX; initialY = e.clientY;
        document.onmouseup = () => { document.onmouseup = null; document.onmousemove = null; };
        document.onmousemove = (ev) => {
          ev.preventDefault();
          posX = initialX - ev.clientX; posY = initialY - ev.clientY;
          initialX = ev.clientX; initialY = ev.clientY;
          elem.style.top = (elem.offsetTop - posY) + "px";
          elem.style.left = (elem.offsetLeft - posX) + "px";
          elem.style.right = "auto"; elem.style.bottom = "auto";
        };
      });

      dragHeader.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          initialX = e.touches[0].clientX; initialY = e.touches[0].clientY;
          document.ontouchend = () => { document.ontouchend = null; document.ontouchmove = null; };
          document.ontouchmove = (ev) => {
            if (ev.touches.length === 1) {
              posX = initialX - ev.touches[0].clientX; posY = initialY - ev.touches[0].clientY;
              initialX = ev.touches[0].clientX; initialY = ev.touches[0].clientY;
              elem.style.top = (elem.offsetTop - posY) + "px";
              elem.style.left = (elem.offsetLeft - posX) + "px";
              elem.style.right = "auto"; elem.style.bottom = "auto";
            }
          };
        }
      }, { passive: false });
    }

    document.querySelectorAll('.draggable-widget').forEach(habilitarArrastre);
  </script>
</body>
