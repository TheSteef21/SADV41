  <!-- Widget Arrastrable 1: Canal Telegram -->
  <div id="widget-safe" class="draggable-widget">
    <div class="draggable-header"><span>⠿ Alerta Sísmica</span><span>LIVE</span></div>
    <a href="https://t.me/Sismosyterremotos" target="_blank" rel="noopener" class="tg-link">
