        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap');
        :root { --accent:#00FFC2; --accent2:#FF4D00; }
        *{font-family:Inter, ui-sans-serif, system-ui, sans-serif}
        .font-display{font-family:"Space Grotesk", Inter, sans-serif}
        .bg-grid{
          background-image:
            linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
          background-size: 32px 32px;
          mask-image: radial-gradient(ellipse at center, black 60%, transparent 95%);
        }
        .glitch{
          position:relative;
          display:inline-block;
          line-height:0.92;
          letter-spacing:-0.03em;
          max-width:100%;
          word-break:break-word;
          overflow-wrap:anywhere;
        }
        .glitch::before, .glitch::after{
          content: attr(data-text);
          position:absolute;
          left:0; top:0;
          width:100%; height:100%;
          overflow:hidden;
          clip-path: inset(0 0 0 0);
        }
        .glitch::before{
          color:#00FFC2;
          transform:translate(-1.5px,0);
          animation: g1 2.1s infinite linear alternate-reverse;
          opacity:.85;
        }
        .glitch::after{
          color:#FF4D00;
          transform:translate(1.5px,0);
          animation: g2 1.9s infinite linear alternate-reverse;
          opacity:.85;
        }
        @keyframes g1{
          0%{clip-path:inset(12% 0 80% 0)}
          20%{clip-path:inset(35% 0 20% 0)}
          40%{clip-path:inset(78% 0 5% 0)}
          60%{clip-path:inset(10% 0 45% 0)}
          80%{clip-path:inset(48% 0 22% 0)}
          100%{clip-path:inset(15% 0 55% 0)}
        }
        @keyframes g2{
          0%{clip-path:inset(55% 0 10% 0)}
          20%{clip-path:inset(10% 0 68% 0)}
          40%{clip-path:inset(25% 0 35% 0)}
          60%{clip-path:inset(68% 0 8% 0)}
          80%{clip-path:inset(18% 0 48% 0)}
          100%{clip-path:inset(5% 0 75% 0)}
        }
        .card-tactical{
          background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
          border:1px solid rgba(255,255,255,0.1);
          transition: all .32s cubic-bezier(.2,.8,.2,1);
          position:relative;
        }
        .card-tactical::before{
          content:"";
          position:absolute; inset:0;
          background: radial-gradient(600px circle at var(--mx,50%) var(--my,50%), color-mix(in srgb, var(--hov) 18%, transparent), transparent 40%);
          opacity:0;
          transition:opacity .3s;
          pointer-events:none;
          border-radius:inherit;
        }
        .card-tactical:hover::before{opacity:1}
        .card-tactical:hover{
          border-color: var(--hov);
          box-shadow: 0 0 0 1px var(--hov), 0 0 30px color-mix(in srgb, var(--hov) 30%, transparent), inset 0 1px 0 rgba(255,255,255,.12);
          transform: translateY(-3px);
        }
        .scan{
          background: repeating-linear-gradient(0deg, rgba(255,255,255,0.04) 0 1px, transparent 1px 3px);
          animation: scanMove 8s linear infinite;
        }
        @keyframes scanMove{from{transform:translateY(0)}to{transform:translateY(24px)}}
        .visual-bar{
          transform-origin: bottom;
          animation: barPulse 0.9s ease-in-out infinite alternate;
        }
        @keyframes barPulse{
          0%{transform:scaleY(0.5)}
          100%{transform:scaleY(1)}
        }
        .fade{animation: fadeUp .7s both}
        @keyframes fadeUp{from{opacity:0; transform:translateY(16px)}to{opacity:1; transform:translateY(0)}}
